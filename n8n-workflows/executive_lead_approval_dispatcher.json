        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          120,
          300
        ],
        "webhookId": "exec-lead-approval-webhook"
      },
      {
        "parameters": {
          "jsCode": "// Parse approval decision and leadId from query or body\nconst query = $input.first().json.query || {};\nconst body = $input.first().json.body || {};\n\nconst leadId = (query.leadId || body.leadId || '').trim();\nconst action = (query.action || body.action || 'approve').toLowerCase().trim();\n\nif (!leadId) {\n  throw new Error('Missing required leadId parameter in approval webhook');\n}\n\nreturn [{\n  json: {\n    leadId,\n    action,\n    timestamp: new Date().toISOString()\n  }\n}];"
        },
        "id": "node-appr-2-parse-action",
        "name": "Parse Approval Action",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          360,
          300
        ]
      },
      {
        "parameters": {
          "operation": "read",
          "documentId": {
            "__rl": true,
            "value": "YOUR_GOOGLE_SHEET_ID",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "Master_Prospects",
            "mode": "name"
          },
          "options": {}
        },
        "id": "node-appr-3-read-sheet",
        "name": "Read Master Sheet",
        "type": "n8n-nodes-base.googleSheets",
        "typeVersion": 4.5,
        "position": [
          600,
          300
        ],
        "credentials": {
          "googleSheetsOAuth2Api": {
            "id": "google-sheets-oauth-cred",
            "name": "Google Sheets Account (shahriar.rusan12@gmail.com)"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Match specific row by Lead ID\nconst target = $('Parse Approval Action').first().json;\nconst rows = $input.all().map(i => i.json);\n\nconst matchedRow = rows.find(r => {\n  const rowId = String(r['Lead ID'] || r.leadId || '').trim();\n  return rowId && rowId.toLowerCase() === target.leadId.toLowerCase();\n});\n\nif (!matchedRow) {\n  throw new Error('Lead ID not found in Master Google Sheet: ' + target.leadId);\n}\n\nconst draftText = matchedRow['Draft Email'] || '';\nconst lines = draftText.split('\\n');\nlet subject = lines.find(l => l.startsWith('Subject:'));\nif (subject) {\n  subject = subject.replace(/^Subject:\\s*/, '').trim();\n} else {\n  subject = lines[0] || 'Executive Leadership Advisory Inquiry';\n}\n\nconst bodyText = draftText.replace(/^Subject:.*\\n+/, '').trim();\n\nreturn [{\n  json: {\n    ...matchedRow,\n    'Lead ID': matchedRow['Lead ID'] || target.leadId,\n    leadId: target.leadId,\n    action: target.action,\n    emailSubject: subject,\n    emailBody: bodyText,\n    recipientEmail: matchedRow['Email'] || 'shahriar.rusan12@gmail.com'\n  }\n}];"
        },
        "id": "node-appr-4-match-row",
        "name": "Find Prospect Record",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          840,
          300
        ]
      },
