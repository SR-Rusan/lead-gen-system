# ==============================================================================
# Executive Lead Intake & Triage System - Environment Configuration
# ==============================================================================

# 1. OpenRouter AI (Primary Brain - Fast + Research tiers)
# Get your free key at: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
OPENROUTER_MODEL_RESEARCH=anthropic/claude-3.5-haiku
OPENROUTER_MODEL_FALLBACK=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000

# 2. Discovery & Scraping APIs (Free tiers available)
# Apify token: https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_MAX_RESULTS=15

# Serper Google Search API (2,500 free queries at https://serper.dev)
SERPER_API_KEY=

# 3. Google Sheets Master Database
# You can use the existing sheet or create a new one:
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
GOOGLE_SHEET_TAB_NAME=Master_Prospects
GOOGLE_SHEET_ANALYTICS_TAB=Funnel_Analytics
GDRIVE_CREDS_DIR=~/.config/gdrive

# 4. Telegram Bot (Human-in-the-Loop Instant Alerts & One-Click Approval)
# Create a bot in 30 seconds via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Gmail Workflow (Safe Outreach Drafts)
# Set to 'true' to only create drafts in your Gmail inbox, never autonomously sending
GMAIL_DRAFT_MODE=true
GMAIL_USER_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="Executive Lead Intake"

# 6. Make.com Integration (eu2.make.com)
MAKE_API_KEY=
MAKE_ORGANIZATION_ID=
MAKE_TEAM_ID=
MAKE_WEBHOOK_INGESTION_URL=
MAKE_WEBHOOK_QUALIFICATION_URL=
MAKE_WEBHOOK_APPROVAL_URL=
MAKE_WEBHOOK_DISPATCH_URL=

# 7. Operational Thresholds & Guardrails
DAILY_OUTREACH_TARGET=10
MAX_RESEARCH_PER_DAY=25
MAX_PROSPECTS_PER_RUN=50
