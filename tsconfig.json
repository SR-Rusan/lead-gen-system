{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "scripts/set_password.ts",
    "scripts/db_sync.ts",
    "api/**/*",
    "scripts/connect_gmail.ts",
    "scripts/find_leads.ts",
    "scripts/rewrite_drafts.ts",
    "scripts/connect_mailbox.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
